generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── TEMPLATES ────────────────────────────────────────────────────────────────

model Template {
  id            String   @id @default(uuid())
  slug          String   @unique  // "floral-design-14463"
  name          String            // "Floral Design"
  folderPath    String            // "floral-design-14463"
  thumbnailUrl  String?           // public URL of the cover image shown on product page
  desktopThumbnailUrl String?     // desktop thumbnail image
  mobileThumbnailUrl  String?     // mobile thumbnail image
  desktopEntryFile String?        // e.g. index_desktop.html
  mobileEntryFile  String?        // e.g. index_mobile.html
  community     String            // hindu|muslim|sikh|christian|jain|parsi|universal
  bestFor       String   @default("") // comma-separated event types e.g. "Wedding, Sangeet, Haldi"
  languages     String   @default("en") // comma-separated: "en, hi, gu"
  style         String?
  colourPalette String?
  animations    String?
  price         Int               // paise — ₹1,999 = 199900
  originalPrice Int?
  gstPercent    Int      @default(0)
  /// Lifts the international price above a straight FX conversion. The USD price
  /// is always derived — price / usdInrRate * markupMultiplier, rounded up to the
  /// next multiple of 10 minus a cent — never stored, so changing the global rate
  /// repositions the whole catalogue at once. NULL means "use the global default"
  /// from AppSetting.defaultMarkupMultiplier.
  markupMultiplier Decimal? @db.Decimal(6, 3)
  /// Optional corner tag on the template card -- 'new', 'trending', etc. One of
  /// lib/constants.js TEMPLATE_BADGES, or NULL for no tag. Stored as the lowercase
  /// key, never the display label, so the wording can change without a migration.
  badge         String?  @db.VarChar(20)
  aboutText     String   @db.Text
  /// One-line storefront sentence for gallery cards and the product page.
  shortDescription String? @db.VarChar(300)
  /// Comma-separated capability chips from TEMPLATE_HIGHLIGHTS (src/lib/constants.js)
  highlights    String?  @db.VarChar(500)
  isActive      Boolean  @default(false)
  buyerCount    Int      @default(0)
  avgRating     Decimal  @default(0) @db.Decimal(3, 2)
  releasedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fieldSchema   Json?             // { people, customFields, mediaSlots?, functionFields } — drives the invitation form

  /// Set only on templates uploaded through the Template Lab. Its presence *is*
  /// the sandbox flag — there is no second boolean to drift out of sync. Every
  /// catalogue-facing query filters `sandboxOwnerId: null` (utils/testFilters.js).
  sandboxOwnerId String?
  sandboxOwner   DeveloperAccount? @relation(fields: [sandboxOwnerId], references: [id], onDelete: Cascade)

  // ── Versioning ──
  // draft folder (templates/{folderPath}/draft/) is mutable — used by /demo and overwritten on every ZIP re-upload.
  // Published snapshots live at templates/{folderPath}/v{n}/ and are pinned per Event for render stability.
  currentVersionId String?
  currentVersion   TemplateVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  demoData      TemplateDemoData?
  events        Event[]
  payments      Payment[]
  reviews       TemplateReview[]
  swapRequests  TemplateSwapRequest[]
  trialDemos    TrialDemo[]
  versions      TemplateVersion[]  @relation("TemplateVersions")

  @@index([sandboxOwnerId])
}

/// Template Lab account — an external template developer.
///
/// Each one owns a paired `sandboxUser` (a normal User flagged isTestAccount)
/// so the sandbox Event has a real owner and every existing test-data filter in
/// utils/testFilters.js excludes it from analytics, cron and retention for free.
model DeveloperAccount {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  /// Slug fragment for the permanent sandbox invite: "arjun" → /i/lab-arjun
  handle        String   @unique
  passwordHash  String
  isActive      Boolean  @default(true)
  sandboxUserId String   @unique
  sandboxUser   User     @relation(fields: [sandboxUserId], references: [id])
  /// Cap on sandbox templates, enforced before a ZIP is extracted.
  templateLimit Int      @default(10)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  templates     Template[]
}

// Immutable snapshot of a template's files taken on publish / publish-changes.
// Each Event pins a version for rendering; publish-changes repoints all events on
// that template to the new snapshot so live invites pick up the new bundle.
model TemplateVersion {
  id               String   @id @default(uuid())
  templateId       String
  template         Template @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber    Int
  folderPath       String   // e.g. "floral-design-14463/v1"
  desktopEntryFile String?
  mobileEntryFile  String?
  fieldSchema      Json?    // snapshot of Template.fieldSchema at publish time
  createdAt        DateTime @default(now())

  currentForTemplates Template[] @relation("CurrentVersion")
  events              Event[]    @relation("EventTemplateVersion")

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model TemplateDemoData {
  id           String   @id @default(uuid())
  templateId   String   @unique
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  brideName    String
  groomName    String
  weddingDate  String
  venueName    String
  venueAddress String?
  photoUrls    Json?
  musicUrl     String?
  language     String   @default("en")
  people       Json?    // [{ role, name, photo_url }] — sample people for demo render
  customFields Json?    // [{ key, value }] — sample custom field values for demo render
  mediaSlotDemoUrls Json? // { slotKey: "https://..." } — demo URLs for media slot preview
  // Links & guests demo settings
  instagramUrl      String?  @db.VarChar(2048)
  instagramHashtag  String?  @db.VarChar(120)
  socialYoutubeUrl  String?  @db.VarChar(2048)
  websiteUrl        String?  @db.VarChar(2048)
  rsvpEnabled       Boolean  @default(true)
  guestNotesEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  functions    TemplateDemoFunction[]
}

model TemplateDemoFunction {
  id           String           @id @default(uuid())
  demoDataId   String
  demoData     TemplateDemoData @relation(fields: [demoDataId], references: [id], onDelete: Cascade)
  name         String
  date         String
  time         String
  venueName    String
  venueAddress String?
  venueMapUrl  String?  @db.VarChar(2048)
  dressCode    String?
  sortOrder    Int              @default(0)
}

model TemplateReview {
  id             String   @id @default(uuid())
  templateId     String
  template       Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  rating         Int
  reviewText     String?  @db.Text
  coupleNames    String?
  location       String?
  couplePhotoUrl String?  @db.VarChar(2048)
  isHidden       Boolean  @default(false)
  isAdminCreated Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// ─── TEMPLATE SWAP ────────────────────────────────────────────────────────────

// Tracks pending template swaps where balance payment is needed
model TemplateSwapRequest {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  eventId        String
  event          Event    @relation("TemplateSwapPrimaryEvent", fields: [eventId], references: [id])
  /// When set, payment applies the same template upgrade to this second event (paired full + partial)
  pairedEventId  String?
  pairedEvent    Event?   @relation("TemplateSwapPairedEvent", fields: [pairedEventId], references: [id], onDelete: SetNull)
  fromTemplateId String
  toTemplateId   String
  toTemplate     Template @relation(fields: [toTemplateId], references: [id])
  balanceAmount  Int      // paise
  payuLinkId  String?
  payuLinkUrl String?
  status         String   @default("pending") // pending|paid|cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   // not unique — same person may register again per purchase with a new username
  username     String?  @unique // global login handle (only display identifier for the account)
  passwordHash String
  /// National digits only — no '+', no spaces. Deliberately left at the default
  /// width: narrowing a populated column risks a truncation failure on deploy for
  /// no real gain, so the length cap is enforced in utils/phone.js instead.
  phone        String?
  /// Dial code for `phone`, e.g. "+91". Split from the number rather than stored
  /// as one E.164 string so the picker can re-render without a parsing library
  /// (+1 and +1242 cannot be separated reliably). Canonical E.164 is the
  /// concatenation, computed on read.
  phoneCountryCode String? @db.VarChar(8)
  consentAt     DateTime? // DPDP: when the user accepted Terms + Privacy Policy
  policyVersion String?   // DPDP: privacy-policy version accepted (e.g. "2026-07-08")
  createdAt    DateTime @default(now())
  /// Owner's permanent template-testing account. Excluded from every admin
  /// analytic, and blocked from checkout, reviews and self-deletion.
  isTestAccount Boolean @default(false)

  events        Event[]
  payments      Payment[]
  reviews       TemplateReview[]
  tickets       SupportTicket[]
  swapRequests  TemplateSwapRequest[]
  /// Present only on the sandbox user paired with a Template Lab developer.
  developerAccount DeveloperAccount?

  @@index([email])
  @@index([isTestAccount])
}

// ─── INVITATIONS ──────────────────────────────────────────────────────────────

model Event {
  id           String    @id @default(uuid())
  slug         String    @unique
  subdomain    String?   @unique
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  templateId   String
  template     Template  @relation(fields: [templateId], references: [id])
  // Pinned template version folder for render; publish-changes updates all rows on this templateId.
  templateVersionId String?
  templateVersion   TemplateVersion? @relation("EventTemplateVersion", fields: [templateVersionId], references: [id], onDelete: SetNull)
  community    String
  eventType    String
  brideName    String?
  groomName    String?
  namesAreFrozen Boolean @default(false)
  language     String    @default("en")
  isPublished  Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  /// full = all functions; subset = selected functions only — paired admin-generated invites share invitePairId
  inviteScope  String?
  invitePairId String?
  lastMilestoneNotified Int?
  countdownEmailSent Int?
  postEventEmailSent Boolean @default(false)
  // DPDP guest-data retention: warning email sent ~88 days after expiry; guest
  // data (guests, RSVPs, wishes, per-guest analytics) erased ≥48h later at day 90.
  guestDataWarningSentAt DateTime?
  guestDataDeletedAt     DateTime?

  /// Optional social / web links (icons live in template HTML; URLs from dashboard)
  instagramUrl      String? @db.VarChar(2048)
  /// Stored without the leading "#"; rendered as {{hashtag}} with one.
  instagramHashtag  String? @db.VarChar(120)
  socialYoutubeUrl  String? @db.VarChar(2048)
  websiteUrl        String? @db.VarChar(2048)
  rsvpEnabled       Boolean @default(true)
  guestNotesEnabled Boolean @default(true)
  /// Denormalised from owner.isTestAccount — written only by the testing endpoint.
  /// Lets Event-rooted queries (render, cron, retention) filter without a join.
  isTestEvent       Boolean @default(false)

  functions    Function[]
  people       EventPerson[]
  venues       Venue[]
  customFields EventCustomField[]
  guests       Guest[]
  rsvps        Rsvp[]
  wishes       GuestWish[]
  media        Media[]
  payments     Payment[]
  analytics    InvitationEvent[]
  tickets      SupportTicket[]
  renderCache  EventRenderCache?
  swapRequests       TemplateSwapRequest[] @relation("TemplateSwapPrimaryEvent")
  swapRequestsPaired TemplateSwapRequest[] @relation("TemplateSwapPairedEvent")
  tasks              Task[]
  inventoryItems     InventoryItem[]
  budget             EventBudget?
  budgetExpenses     BudgetExpense[]
  eventVendors       EventVendor[]
  timelineEntries    TimelineEntry[]
  moodBoardPins      MoodBoardPin[]
  gifts              Gift[]
  photoWallItems     PhotoWallItem[]

  @@index([invitePairId])
  @@index([isTestEvent])
}

// ─── EVENT PEOPLE (dynamic roles) ────────────────────────────────────────────

model EventPerson {
  id        String  @id @default(uuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role      String  // bride, groom, bride_father, groom_father, bride_mother, groom_mother,
                    // birthday_person, retiree, host, celebrant, etc.
  name      String
  photoUrl  String?
  extraData Json?   // any role-specific data (e.g. bio, relationship, subtitle)
  sortOrder Int     @default(0)

  @@index([eventId])
}

// ─── VENUES ──────────────────────────────────────────────────────────────────

model Venue {
  id       String   @id @default(uuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  address  String?
  lat      Decimal? @db.Decimal(10, 8)
  lng      Decimal? @db.Decimal(11, 8)
  mapUrl   String?  @db.VarChar(2048)
  city     String?
  state    String?

  functions Function[]

  @@index([eventId])
}

// ─── CUSTOM FIELDS (flexibility layer) ───────────────────────────────────────

model EventCustomField {
  id         String @id @default(uuid())
  eventId    String
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldKey   String   // love_story, mehendi_artist, mehr_amount, cake_flavor, hashtag, etc.
  fieldValue String   @db.Text
  fieldType  String   @default("text") // text, number, json, date, html

  @@unique([eventId, fieldKey])
  @@index([eventId])
}

// ─── RENDER CACHE ────────────────────────────────────────────────────────────

model EventRenderCache {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  htmlDesktop String   @db.LongText
  htmlMobile  String   @db.LongText
  dataJson    Json
  builtAt     DateTime @default(now())
}

model Function {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime @db.Date
  startTime    String?
  endTime      String?
  venueId      String?
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueName    String?
  venueAddress String?
  venueLat     Decimal? @db.Decimal(10, 8)
  venueLng     Decimal? @db.Decimal(11, 8)
  /// Share link (e.g. maps.app.goo.gl or google.com/maps/place/…); lat/lng optional when set
  venueMapUrl  String?  @db.VarChar(2048)
  dressCode    String?
  notes        String?  @db.Text
  sortOrder    Int      @default(0)

  rsvps        Rsvp[]
}

// ─── GUESTS & RSVPs ───────────────────────────────────────────────────────────

model Guest {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  side        String?
  tags        String?
  inviteToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  rsvps       Rsvp[]
  analytics   InvitationEvent[]
}

model Rsvp {
  id             String   @id @default(uuid())
  guestId        String
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  functionId     String
  function       Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attending      Boolean?
  plusCount      Int      @default(0)
  mealPreference String?
  message        String?  @db.Text
  submittedAt    DateTime @default(now())

  @@unique([guestId, functionId])
}

model GuestWish {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestName  String
  message    String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([eventId])
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────

model InvitationEvent {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  guestId   String?
  guest     Guest?   @relation(fields: [guestId], references: [id])
  type      String   // opened|rsvp_started|rsvp_submitted|music_played|map_clicked
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── MEDIA ────────────────────────────────────────────────────────────────────

model Media {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // photo|music|background|video
  url       String
  caption   String?
  slotKey   String?  // maps to fieldSchema.mediaSlots[].key (ganesh, couple_carousel, …)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id                String   @id @default(uuid())
  orderId           String?  @unique // AO-DDMMYY-HHMMSS-XXXX — human-readable reference, not used in any logic
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  eventId           String?
  event             Event?   @relation(fields: [eventId], references: [id])
  templateId        String
  template          Template @relation(fields: [templateId], references: [id])
  /// PayU's own ids. Still the lookup key on every PayU callback and IPN, because
  /// that is what PayU sends back. NULL on a Razorpay order.
  payuTxnId         String?
  payuMihpayid      String?
  /// Which gateway took this money: "payu" or "razorpay". Backfilled to "payu"
  /// on every row that existed before Razorpay, so it is never unknown.
  gateway           String   @default("payu")
  /// The same two ids, named without a gateway in them, so the admin, the
  /// refund path and the emails read one pair of columns whoever settled the
  /// order. For PayU these MIRROR payuTxnId / payuMihpayid (written together,
  /// never separately); for Razorpay they are order_id and payment_id and the
  /// payu* columns stay NULL.
  gatewayOrderId    String?
  gatewayPaymentId  String?
  customerEmail     String?
  couponCode        String?
  discountAmount    Int?     @default(0)
  /// Minor units OF `currency` — paise for INR (₹2,999 = 299900), cents for USD
  /// ($59.99 = 5999). NEVER sum this column across rows without grouping by
  /// `currency`, or rupees get added to dollars.
  amount            Int
  currency          String   @default("INR")
  /// Which storefront the sale came through, and therefore which PayU merchant
  /// account settles it. Kept separate from `currency` on purpose: currency is
  /// what the buyer was charged, this is where the order came from and which
  /// account to reconcile it against.
  storefront        String   @default("IN")   // IN | INTL
  /// ISO-3166 alpha-2 from cf-ipcountry at order creation. Evidence that an
  /// international sale was genuinely an export, which is what zero-rating GST
  /// rests on. Matches WebsiteSession.country so the two can be compared.
  countryCode       String?  @db.VarChar(2)
  /// Snapshots of the pricing inputs at time of sale, so an old order stays
  /// explainable after the global rate or markup changes. NULL on INR orders.
  fxRate            Decimal? @db.Decimal(12, 4)
  markupMultiplier  Decimal? @db.Decimal(6, 3)
  /// GST charged, in the same minor units as `amount`. Zero on the international
  /// storefront (export of services is zero-rated). Previously the tax split was
  /// not persisted at all and could not be recovered from the inclusive total.
  gstAmount         Int?     @default(0)
  status            String   @default("pending") // pending|paid|failed|refunded
  /// When the refund was actually issued, so a refund falls in the GST period it
  /// was made in rather than the one the sale was made in. Before these columns
  /// existed a refund wrote only `status`, so refunds recorded then have no date
  /// and stay NULL — the GST report lists those under the order date and says so.
  refundedAt        DateTime?
  /// Minor units of `currency`, like `amount`. Today always the whole amount;
  /// a column of its own so a partial refund needs no migration.
  refundAmount      Int?
  refundReference   String?  // the gateway's own refund id
  isOnboarded       Boolean  @default(false)
  onboardedAt       DateTime?
  reminderSentAt    DateTime?
  abandonedEmailSentAt DateTime? // abandoned-checkout recovery email (pending payments)
  consentAt         DateTime? // DPDP: when Terms + Privacy Policy were accepted at checkout
  policyVersion     String?   // DPDP: privacy-policy version accepted
  marketingOptIn    Boolean  @default(false) // DPDP: consent to reminder/offer emails (abandoned checkout)
  /// Set when the buyer arrived from a "try it with your names" demo, so the
  /// builder can be prefilled with the details they already typed. The demo row
  /// is erased within a day and this becomes NULL; the payment is untouched.
  trialDemoId       String?
  trialDemo         TrialDemo? @relation(fields: [trialDemoId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@index([storefront, status])
  @@index([trialDemoId])
  /// Every gateway callback, IPN and webhook looks a payment up by one of these.
  /// They were unindexed full scans before Razorpay made the traffic worth it.
  @@index([payuTxnId])
  @@index([gatewayOrderId])
  @@index([gateway, status])
}

/// "Try it with your names" — a personal, watermarked demo of a real template,
/// created with no account and no payment.
///
/// This holds the only personal data a visitor gives before buying, so it is
/// built to be short-lived: `linkExpiresAt` stops the link working after
/// minutes, and the scheduled purge deletes the row once `dataExpiresAt` passes.
/// The caller's IP is never stored — `ipHash` is a salted SHA-256 used only to
/// cap how many demos one address may create, and it goes with the row.
model TrialDemo {
  id            String   @id @default(uuid())
  /// 32 hex characters from crypto.randomBytes: unguessable and URL-safe.
  token         String   @unique @db.VarChar(32)
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// The validated payload: names, wedding date, venue, city and ceremonies.
  payload       Json
  ipHash        String?  @db.VarChar(64)
  linkExpiresAt DateTime
  dataExpiresAt DateTime
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())

  payments      Payment[]

  @@index([dataExpiresAt])
  @@index([ipHash, createdAt])
  @@index([templateId])
}

model CouponCode {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Int
  expiresAt       DateTime?
  maxGlobalUses   Int?
  maxUsesPerUser  Int?
  minOrderAmount  Int?     @default(0) // paise
  isActive        Boolean  @default(true)
  /// Advertise this coupon on the public checkout page. Distinct from isActive:
  /// an undisplayed coupon still works when typed. Off by default so a partner
  /// or one-off code is never published by accident.
  isDisplayed     Boolean  @default(false)
  /// Which storefront may redeem this code. Existing coupons were all written
  /// against India pricing, so the default keeps them home-only — an India
  /// campaign must not leak abroad and give away the markup it exists for.
  storefront      String   @default("IN") // IN | INTL | BOTH
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── SUPPORT TICKETS ──────────────────────────────────────────────────────────

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?          @relation(fields: [eventId], references: [id])
  subject   String
  status    String          @default("open") // open|resolved
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  TicketMessage[]
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole String        // user|admin
  body       String        @db.Text
  createdAt  DateTime      @default(now())
}

// ─── GLOBAL ASSETS ────────────────────────────────────────────────────────────

model GlobalAsset {
  id        String   @id @default(uuid())
  type      String   // e.g., "bg_music"
  name      String
  url       String   @db.VarChar(2048)
  createdAt DateTime @default(now())
}

// ─── TASKS (wedding planning scheduler) ───────────────────────────────────────

model Task {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title      String
  category   String   @default("Other")   // Venue, Catering, Photography, Attire, Invitations, Decor, Travel, Other
  dueDate    String?                       // YYYY-MM-DD (frontend sends/reads as string)
  priority   String   @default("medium")   // low, medium, high
  assignedTo String?                       // bride, groom, family, vendor
  status     String   @default("todo")     // todo, inprogress, done
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([eventId])
}

// ─── INVENTORY (track items for the wedding) ──────────────────────────────────

model InventoryItem {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  category      String   @default("Other")
  subCategory   String?
  quantity      Int      @default(1)
  unit          String   @default("pcs")
  status        String   @default("to-buy")  // to-buy, ordered, received, packed, at-venue, done
  location      String?
  assignedTo    String?
  vendor        String?
  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)
  reminderDate  String?                      // YYYY-MM-DD
  reminderNote  String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
}

// ─── BUDGET (total budget + expense entries) ──────────────────────────────────

model EventBudget {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  totalBudget Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BudgetExpense {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  description String
  category    String   @default("Other")
  vendor      String?
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  paid        Boolean  @default(false)
  dueDate     String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

// ─── VENDORS (service providers) ──────────────────────────────────────────────

model EventVendor {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("Other")       // Photography, Catering, Decor, Music, Attire, Priest, Transport, Makeup, Mehendi, Other
  contactName String?
  phone       String?
  email       String?
  website     String?  @db.VarChar(2048)
  packageName String?
  packageCost Decimal? @db.Decimal(12, 2)
  depositPaid Decimal? @db.Decimal(12, 2)
  totalPaid   Decimal? @db.Decimal(12, 2)
  status      String   @default("contacted")   // contacted, negotiating, booked, deposit-paid, fully-paid, cancelled
  bookingDate String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

// ─── TIMELINE (day-of schedule) ───────────────────────────────────────────────

model TimelineEntry {
  id                String   @id @default(uuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId        String?                    // ties to a ceremony
  time              String                     // e.g. "10:30 AM"
  title             String
  location          String?
  responsiblePerson String?
  duration          String?                    // e.g. "30 mins"
  notes             String?  @db.Text
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventId])
}

// ─── MOOD BOARD (inspiration pins) ────────────────────────────────────────────

model MoodBoardPin {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl  String   @db.VarChar(2048)
  caption   String?
  category  String   @default("Other")
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ─── GIFTS (gift tracker) ─────────────────────────────────────────────────────

model Gift {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromName        String
  fromRelation    String?
  giftDescription String?
  receivedDate    String?
  estimatedValue  Decimal? @db.Decimal(12, 2)
  thankYouSent    Boolean  @default(false)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([eventId])
}

// ─── PHOTO WALL (private post-event album) ────────────────────────────────────

model PhotoWallItem {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(2048)
  caption   String?
  category  String   @default("Ceremony")
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ─── AUTH AUDIT LOG (DPDP Rule 6(c)/(e): security logs, retained ≥1 year) ─────

model AuthAuditLog {
  id        String   @id @default(uuid())
  event     String   @db.VarChar(64)   // user_login_success|user_login_failed|recovery_code_sent|account_deleted|…
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(160)
  userId    String?                    // not a relation — must survive account deletion
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
}

// ─── WEBSITE ANALYTICS (first-party tracking for the marketing site) ──────────

model WebsiteSession {
  id          String   @id @db.VarChar(64)   // client-generated UUID (anonymous, no PII)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // First-touch attribution — set on session create, never updated
  referrer    String?  @db.VarChar(255)      // referrer hostname only, e.g. "google.com"
  utmSource   String?  @db.VarChar(128)
  utmMedium   String?  @db.VarChar(128)
  utmCampaign String?  @db.VarChar(128)
  deviceType  String?  @db.VarChar(16)       // mobile|tablet|desktop
  browser     String?  @db.VarChar(64)
  os          String?  @db.VarChar(64)
  country     String?  @db.VarChar(64)       // from Cloudflare cf-ipcountry header
  region      String?  @db.VarChar(128)      // from cf-region (needs CF "visitor location headers" transform)
  city        String?  @db.VarChar(128)      // from cf-ipcity
  /// Which website the session belongs to — drives the India/International filter
  /// on the admin Analytics tab. Nullable because rows predating the global site
  /// have no answer; treat NULL as 'IN' when reporting.
  storefront  String?  @db.VarChar(8)        // IN | INTL
  pageViews   Int      @default(0)
  events      WebsiteEvent[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([storefront, firstSeenAt])
}

model WebsiteEvent {
  id        String   @id @default(uuid())
  sessionId String   @db.VarChar(64)
  session   WebsiteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(32)  // allowlist: src/lib/analyticsEvents.js (pageview, funnel stages, storefront interactions)
  path      String   @db.VarChar(512)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
}

// One row per completed day — survives the 90-day raw-event prune.
model WebsiteDailyStat {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  /// One row per (date, storefront) — the two websites roll up separately so the
  /// admin filter can show either alone or both summed.
  storefront  String   @default("IN") @db.VarChar(8) // IN | INTL
  visitors    Int      @default(0)   // sessions that started that day
  pageViews   Int      @default(0)
  sources     Json?    // { "(direct)": 40, "google.com": 12, ... }
  devices     Json?    // { mobile, tablet, desktop }
  countries   Json?    // { IN: 50, US: 2 }
  conversions Json?    // { view_template, initiate_checkout, purchase, register_complete }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, storefront])
}

/// Runtime settings an admin edits, read together and changed rarely. Key/value
/// rather than a column each so the next setting needs no migration.
/// Known keys: `usdInrRate` (e.g. "96"), `defaultMarkupMultiplier` (e.g. "1.8").
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── BLOG (admin-managed content marketing) ───────────────────────────────────

model BlogPost {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String?   @db.Text
  coverImageUrl   String?   @db.VarChar(2048)   // R2 URL (blog/{slug}/cover.ext)
  content         String    @db.LongText        // markdown
  metaTitle       String?                       // SEO title override
  metaDescription String?   @db.Text            // SEO description override
  tags            String?                       // comma-separated: "wedding, invitations, tips"
  author          String    @default("Aamantran Team")
  status          String    @default("draft")   // draft | published
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}
