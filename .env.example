# ── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/aamantran"

# ── App URLs ──────────────────────────────────────────────────
# Local dev (default). On Railway production, use:
#   API_BASE_URL=https://api.aamantran.online
#   LANDING_URL=https://www.aamantran.online
#   ADMIN_URL=https://admin.aamantran.online
#   COUPLE_DASHBOARD_URL=https://app.aamantran.online
API_BASE_URL="http://localhost:4000"
LANDING_URL="http://localhost:3000"
# International storefront (aamantranglobal.com) — a second deployment of the
# same website, priced in USD. Its own origin because a buyer who paid there must
# be redirected back there, not to the India site.
#
# NOTE: the CORS allowlist is built once at boot, so this must be set and the API
# REDEPLOYED before aamantranglobal.com takes traffic — otherwise that site loads
# fine and then fails silently at checkout.
LANDING_URL_INTL="http://localhost:3002"
ADMIN_URL="http://localhost:5174"
COUPLE_DASHBOARD_URL="http://localhost:3001"

# ── "Try it with your names" demos ────────────────────────────
# A visitor can preview a design with their own names, with no account and no
# payment. TRIAL_IP_SALT must be set to a long random value in production: it
# salts the SHA-256 of the caller's IP, which is the only identifier stored, and
# an unsalted hash of an IPv4 address can be reversed by brute force. With it
# unset the per-IP cap is skipped and only the request rate limiter applies.
TRIAL_IP_SALT=""
# Minutes the shareable link keeps working.
TRIAL_DEMO_LINK_MINUTES="15"
# Hours the typed details are kept, so a purchase can be prefilled from them.
TRIAL_DEMO_DATA_HOURS="24"
# Demos one address may create per hour, and the ceiling across all visitors per day.
TRIAL_DEMO_PER_IP_CAP="5"
TRIAL_DEMO_DAILY_CAP="2000"
# Requests per hour per address to POST /api/trial-demo.
RATE_LIMIT_TRIAL_DEMO_MAX="5"

# ── Storage ───────────────────────────────────────────────────
STORAGE_PATH="./storage"
# Optional: Cloudflare R2 (S3 API). When ALL are set, templates + media go to R2
# and R2_PUBLIC_BASE_URL is used in HTML / DB. Omit for local disk + /s/ + /uploads/.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="aamantran-prod"
# R2_PUBLIC_BASE_URL="https://media.aamantran.online"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="8h"

# ── Admin Credentials ─────────────────────────────────────────
ADMIN_EMAIL="aamantran@plexzuu.com"
ADMIN_PASSWORD="change-this-password"

# ── PayU ─────────────────────────────────────────────────────
# TWO merchant accounts, one per storefront. They deliberately do NOT fall back
# to one another: signing an order with the wrong salt would either be rejected
# by PayU or settle into the wrong merchant account, so a missing international
# key fails the checkout loudly instead.
PAYU_MERCHANT_KEY="xxxxxxxx"
PAYU_MERCHANT_SALT="xxxxxxxxxxxxxxxx"

# aamantranglobal.com — the account with international payments enabled. Charges
# in USD. Required before the global storefront can take a payment.
PAYU_INTL_MERCHANT_KEY="xxxxxxxx"
PAYU_INTL_MERCHANT_SALT="xxxxxxxxxxxxxxxx"

# 'test' or 'prod'. WARNING: defaults to prod, so leaving this unset points at
# live PayU. Set it explicitly when testing.
# PAYU_ENV="test"

# ── Razorpay ─────────────────────────────────────────────────
# Takes the global storefront's payments by default, and either storefront's if
# an admin says so. Test or live is decided by the key itself (rzp_test_ vs
# rzp_live_), so there is no environment switch to forget.
#
# KEY_ID is public: it is handed to the payment window in the buyer's browser.
# KEY_SECRET signs and verifies payments and must never leave the server.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"
# From the webhook you create in the Razorpay dashboard, pointing at
# /webhooks/razorpay with the events payment.captured and payment.failed.
# WITHOUT THIS every webhook is refused, which means a buyer who closes the tab
# mid-payment is not completed automatically.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxx"

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="aamantran@plexzuu.com"

NODE_ENV="development"
PORT=4000

# Dev/staging only: checkout skips PayU; "Pay Now" completes via /api/checkout/mock-success.
# Never set true in production. mock-success is blocked when NODE_ENV=production.
# DUMMY_PAYMENT_MODE="true"

# Optional rate limits (requests per window) — see src/middleware/rateLimits.js
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_RECOVERY_MAX=10
# RATE_LIMIT_CHECKOUT_MAX=120
# RATE_LIMIT_PUBLIC_INVITE_MAX=200
# RATE_LIMIT_LOOKUP_MAX=60
# RATE_LIMIT_TRACK_MAX=120
# RATE_LIMIT_LAB_UPLOAD_MAX=60

# Set TRUST_PROXY=0 only if the API is never behind a reverse proxy
# TRUST_PROXY=0

# ── Template Lab (external template developers) ──────────────────────────
# Origin of the Lab app. Used for CORS and for the frame-ancestors override
# that lets the Lab embed a sandbox invite in its device-preview iframe.
# Defaults: http://localhost:5175 (dev), https://lab.aamantran.online (prod).
# LAB_URL="https://lab.aamantran.online"

# Signing secret for developer JWTs. Falls back to JWT_SECRET when unset;
# tokens stay safe either way because the issuer and role are both checked,
# but a distinct secret is preferred so revoking Lab access cannot disturb
# admin or couple sessions.
# JWT_SECRET_DEV="<long random string>"
